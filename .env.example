DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budgetwise

# Email (password reset) — uses Resend (https://resend.com)
# Without RESEND_API_KEY, reset links are only logged to the server console (dev fallback).
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend dashboard.
# The default onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=Budget Wise <no-reply@your-verified-domain.com>
# Optional. Base URL used to build the reset link. Falls back to the request host if unset.
APP_URL=https://your-production-host
